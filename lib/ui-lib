#!/usr/bin/env bash
# ==============================================================================
# ui-lib — 색·출력·질문 공용 함수 (DevTools2 설치 스크립트 공용)
# ==============================================================================
# 원본은 이 저장소(_devtools2-setup) 하나입니다. _devtools2 는 submodule 로 이 파일을 불러 씁니다.
#   - 시작 스크립트(install.sh): bw-lib 보다 먼저 불러 Bitwarden 로그인 질문에 씀
#   - _devtools2 의 _common.sh: 같은 함수를 이 파일에서 불러 씀
# 사용법: source "<경로>/lib/ui-lib"
# ==============================================================================

# ANSI 색상 코드 (터미널 미지원 환경에서 비활성화)
if [ -t 1 ] && [ "${TERM:-}" != "dumb" ]; then
    _C_RESET=$'\033[0m'
    _C_BOLD=$'\033[1m'
    _C_CYAN=$'\033[0;36m'       # [정보] / 구분선 / Step 헤더
    _C_GREEN=$'\033[0;32m'      # [성공] [완료]
    _C_YELLOW=$'\033[0;33m'     # [경고]
    _C_RED=$'\033[0;31m'        # [오류]
    _C_WHITE=$'\033[1;37m'      # 일반 강조
    _C_GRAY=$'\033[0;90m'       # 보조 설명
    _C_DEFAULT=$'\033[1;32m'    # 기본값 강조 (초록+볼드) — [기본값] 태그 및 선택 프롬프트 기본값 문자에 사용
else
    _C_RESET='' _C_BOLD='' _C_CYAN='' _C_GREEN='' _C_YELLOW=''
    _C_RED='' _C_WHITE='' _C_GRAY='' _C_DEFAULT=''
fi

# ── 출력 헬퍼 ──────────────────────────────────────────────────────────────
print_info()    { printf "${_C_CYAN}[정보]${_C_RESET} %s\n"    "$*"; }
print_success() { printf "${_C_GREEN}[성공]${_C_RESET} %s\n"   "$*"; }
print_done()    { printf "${_C_GREEN}[완료]${_C_RESET} %s\n"   "$*"; }
print_skip()    { printf "${_C_YELLOW}[건너뜀]${_C_RESET} %s\n" "$*"; }
print_warn()    { printf "${_C_YELLOW}[경고]${_C_RESET} %s\n"  "$*"; }
print_error()   { printf "${_C_RED}[오류]${_C_RESET} %s\n"     "$*" >&2; }
print_step()    { printf "${_C_CYAN}%s${_C_RESET}\n"         "$*"; }
print_sep()     { printf "${_C_CYAN}%s${_C_RESET}\n" "==========================================================================="; }
print_banner()  { echo ""; print_sep; printf "  ${_C_CYAN}%s${_C_RESET}\n" "$*"; print_sep; echo ""; }
print_subsep()  { printf "${_C_CYAN}%s${_C_RESET}\n" "---------------------------------------------------------------------------"; }

# ── tty 정규화 헬퍼 ─────────────────────────────────────────────────────────
# bind -x (Readline 단축키) 환경에서 터미널을 canonical 모드로 복원합니다.
# Readline이 설정한 raw 모드(-icanon -icrnl)에서는 Enter(\r)가 개행(\n)으로
# 변환되지 않아, read/sudo 등의 대화형 입력이 실패합니다. 이 함수를 호출하면
# icanon(행 편집), icrnl(CR→NL 변환), echo(입력 에코)를 복원합니다.
normalize_tty() {
    if [ -c /dev/tty ]; then
        # 제어 터미널이 없으면(/dev/tty 열기 실패) 리다이렉션 오류 자체가 출력되므로 블록 전체의 stderr 를 버림
        { stty icanon icrnl echo < /dev/tty; } 2>/dev/null || true
    elif [ -t 0 ]; then
        stty icanon icrnl echo 2>/dev/null || true
    fi
}

# ── 프롬프트 / 질문 헬퍼 ──────────────────────────────────────────────
# 비대화형 판정: DT2_NONINTERACTIVE=1 이거나, 질문을 읽을 터미널이 없을 때 참(0)
# ⚠️ "A || B && C" 는 bash 에서 "(A || B) && C" 로 평가되어 DT2_NONINTERACTIVE=1 이 터미널에서
#    무시됐습니다. 또 /dev/tty 장치 파일은 제어 터미널이 없어도 항상 존재하므로 [ -c /dev/tty ]
#    대신 실제로 열 수 있는지로 판정합니다.
dt2_is_noninteractive() {
    [ "${DT2_NONINTERACTIVE:-0}" = "1" ] && return 0
    [ -t 0 ] && return 1
    { : </dev/tty; } 2>/dev/null && return 1
    return 0
}
print_question() { printf "${_C_BOLD}${_C_CYAN}%s${_C_RESET}\n" "$*"; }
print_option() {
    local num="$1" text="$2" default_tag="${3:-}"
    if [ -n "$default_tag" ]; then
        printf "   ${_C_YELLOW}${_C_BOLD}%s)${_C_RESET} ${_C_WHITE}%s${_C_RESET} ${_C_DEFAULT}%s${_C_RESET}\n" "$num" "$text" "$default_tag"
    else
        printf "   ${_C_YELLOW}${_C_BOLD}%s)${_C_RESET} ${_C_WHITE}%s${_C_RESET}\n" "$num" "$text"
    fi
}
prompt_input() { printf "${_C_YELLOW}${_C_BOLD}%s${_C_RESET} " "$*"; }
# prompt_read <varname> <prompt message>
# prompt_input + read -r 를 하나의 함수로 처리합니다.
# 사용법: prompt_read my_var "선택하세요 [y/N]: "
prompt_read() {
    local _pr_var="$1"; shift
    if dt2_is_noninteractive; then
        eval "$_pr_var=\"\""
        return 0
    fi
    stty sane 2>/dev/null || true
    prompt_input "$@"
    # shellcheck disable=SC2229  # 변수 이름을 받아 그 변수에 읽음 (의도한 동작)
    IFS= read -r "$_pr_var" </dev/tty || true
    dt2_clean_input "$_pr_var"
    stty sane 2>/dev/null || true
    echo ""
}

# 입력값 정리 — dt2_clean_input <변수 이름> (prompt_read 가 모든 입력에 적용 → prompt_text·prompt_key·prompt_confirm 도 해당)
#   화면에 안 보이는데 값에 섞여 들어가는 것을 지웁니다(실측: Bitwarden 이메일이 공백처럼 보이는 문자 때문에 "형식 아님"으로 거부됨).
#   ● Esc(영문 전환 키)가 남긴 키 신호 — strip_term_escapes
#   ● 깨진 UTF-8 바이트(한글 입력기가 조합 중에 남긴 글자 조각) — iconv -c (값은 표준 입력으로만 넘김, 인자에 노출 안 함)
#   ● 폭 없는 공백(U+200B~200D)·BOM(U+FEFF)
#   ● 앞뒤 공백(전각 공백 포함). 가운데 공백과 한글 등 정상 문자는 그대로 둡니다(경로·이름에 쓰일 수 있음).
#   비밀번호는 prompt_password 가 따로 처리합니다(비영문 문자를 지우지 않고 거부).
dt2_clean_input() {
    strip_term_escapes "$1"
    local _ci="${!1}" _ci2
    if command -v iconv >/dev/null 2>&1; then
        # iconv -c 는 깨진 바이트를 지웠을 때도 종료 코드 1 을 돌려주므로 종료 코드가 아니라 결과로 판단합니다
        _ci2=$(printf '%s' "$_ci" | iconv -c -f UTF-8 -t UTF-8 2>/dev/null)
        [ -n "$_ci2" ] && _ci="$_ci2"
    fi
    _ci="${_ci//$'\xe2\x80\x8b'/}"
    _ci="${_ci//$'\xe2\x80\x8c'/}"
    _ci="${_ci//$'\xe2\x80\x8d'/}"
    _ci="${_ci//$'\xef\xbb\xbf'/}"
    _ci="${_ci#"${_ci%%[![:space:]]*}"}"
    _ci="${_ci%"${_ci##*[![:space:]]}"}"
    printf -v "$1" '%s' "$_ci"
}

# ── Yes/No 확인 프롬프트 헬퍼 ─────────────────────────────────────────
# prompt_confirm <prompt_message> [default: N|Y]
# 반환: 0(참) = 'y'/'Y', 1(거짓) = 그 외
prompt_confirm() {
    local _msg="$1"
    local _def="${2:-N}"
    local _ans=""

    # 비대화형 모드(DT2_NONINTERACTIVE=1 또는 tty 부재) 시 기본값 즉시 적용
    if dt2_is_noninteractive; then
        print_info "비대화형 모드: ${_msg} → 기본값($_def) 자동 선택"
        if [ "$_def" = "Y" ] || [ "$_def" = "y" ]; then
            return 0
        else
            return 1
        fi
    fi

    if [ "$_def" = "Y" ] || [ "$_def" = "y" ]; then
        prompt_read _ans "${_msg} [${_C_DEFAULT}Y${_C_RESET}${_C_YELLOW}${_C_BOLD}/n]:"
        _ans=$(echo "${_ans:-y}" | tr '[:upper:]' '[:lower:]')
    else
        prompt_read _ans "${_msg} [y/${_C_DEFAULT}N${_C_RESET}${_C_YELLOW}${_C_BOLD}]:"
        _ans=$(echo "${_ans:-n}" | tr '[:upper:]' '[:lower:]')
    fi
    # y·yes 와 한글 입력 상태의 y 키('ㅛ')를 "예"로 봅니다(Windows _common.ps1 Test-YesAnswer 와 같은 기준).
    #   예전에는 정확히 "y" 만 예로 봐서 'ㅛ' 나 "yes" 가 "아니요"로 처리됐습니다.
    _ans="${_ans#"${_ans%%[![:space:]]*}"}"
    case "$_ans" in y*|ㅛ*) return 0 ;; *) return 1 ;; esac
}

# ── 문자 입력 프롬프트 헬퍼 (기본값 초록색 표시) ───────────────────────────
# prompt_text <varname> <prompt_message> [default]
# 기본값이 있으면 "메시지 [기본값: X]:" 처럼 기본값을 초록색으로 보여 주고, Enter 만 누르면 기본값을 씁니다.
# (질문 색·기본값 색을 prompt_confirm 과 같게 맞추기 위한 공용 함수 — 직접 read -rp 로 묻지 마세요)
# 사용법: prompt_text _name "👤 user.name" "$_default_name"
prompt_text() {
    local _pt_var="$1" _pt_msg="$2" _pt_def="${3:-}" _pt_in=""
    if [ -n "$_pt_def" ]; then
        prompt_read _pt_in "${_pt_msg} [기본값: ${_C_DEFAULT}${_pt_def}${_C_RESET}${_C_YELLOW}${_C_BOLD}]:"
    else
        prompt_read _pt_in "${_pt_msg}:"
    fi
    printf -v "$_pt_var" '%s' "${_pt_in:-$_pt_def}"
}

# ── 글자 선택 프롬프트 헬퍼 ([P/e] 처럼 기본값을 초록색 대문자로 표시) ─────────────
# prompt_key <varname> <prompt_message> <기본 키> <키> [<키>...]
# 결과: 고른 키(소문자). Enter 는 기본값, 목록에 없는 입력이면 다시 묻습니다(무인 실행은 기본값).
# 기본 키를 "" 로 주면 기본값 없이 반드시 고르게 합니다(예: 덮어쓰기 위험이 있는 업로드/다운로드 선택).
# 사용법: prompt_key _ans "무엇을 다시 입력할까요? 비밀번호(p) / 이메일(e)" p p e   → "... [P/e]:"
prompt_key() {
    local _pk_var="$1" _pk_msg="$2" _pk_def="${3,,}"
    shift 3
    local _pk_keys=("$@") _pk_k _pk_disp="" _pk_in=""
    for _pk_k in "${_pk_keys[@]}"; do
        _pk_k="${_pk_k,,}"
        [ -n "$_pk_disp" ] && _pk_disp+="/"
        if [ "$_pk_k" = "$_pk_def" ]; then
            _pk_disp+="${_C_DEFAULT}${_pk_k^^}${_C_RESET}${_C_YELLOW}${_C_BOLD}"
        else
            _pk_disp+="${_pk_k}"
        fi
    done
    while true; do
        prompt_read _pk_in "${_pk_msg} [${_pk_disp}]:"
        _pk_in="${_pk_in,,}"
        _pk_in="${_pk_in:-$_pk_def}"
        for _pk_k in "${_pk_keys[@]}"; do
            [ -n "$_pk_in" ] || break
            if [ "$_pk_in" = "${_pk_k,,}" ]; then
                printf -v "$_pk_var" '%s' "$_pk_in"
                return 0
            fi
        done
        if dt2_is_noninteractive; then
            printf -v "$_pk_var" '%s' "$_pk_def"
            return 0
        fi
        print_warn "$(printf '%s ' "${_pk_keys[@]}")중 하나를 입력해 주세요."
    done
}

# 터미널 키 신호 제거 — strip_term_escapes <변수 이름>
# 비밀번호처럼 화면에 안 보이게(read -s) 받은 입력에서 ESC(0x1B)로 시작하는 키 신호를 지운다.
# Esc 를 눌러 영문으로 바꾸는 설정(Windows AutoHotkey 의 ~Esc — 원래 Esc 도 그대로 전달, Linux keyd 의 esc + Ctrl+Alt+Shift+F11)은
# 입력 중에 누르면 ESC·`ESC[23;8~` 같은 문자열이 입력값에 섞여, 비영문 검사에 걸리거나 비밀번호가 틀린다.
# 비밀번호에 ESC 가 들어갈 일은 없으므로 지워도 안전하다. 값이 프로세스 인자로 노출되지 않게 bash 안에서만 처리한다.
strip_term_escapes() {
    local LC_ALL=C _s="${!1}" _old
    # ⚠️ || true 필수: shopt -p 는 옵션이 꺼져 있으면 종료 코드 1 → set -e 스크립트(설치 단계)가 여기서 아무 말 없이 끝났습니다
    #    (prompt_read 가 모든 입력에 이 함수를 쓰므로 "선택 [1/2]:" 직후 "핵심 도구 설치 실패" — 새 PC 설치 실측).
    _old=$(shopt -p extglob || true)
    shopt -s extglob
    _s="${_s//$'\e'\[*([0-9;?])[@-~]/}"   # CSI: ESC [ 숫자·; 끝문자(기능키·방향키 등)
    _s="${_s//$'\e'O[@-~]/}"              # SS3: ESC O 끝문자(F1~F4 등)
    _s="${_s//$'\e'/}"                    # 남은 ESC(Esc 키 단독)
    eval "$_old"
    printf -v "$1" '%s' "$_s"
}

# ── 비밀번호 입력 프롬프트 헬퍼 (비영문/다국어 입력 방지 및 재입력 유도) ──
# prompt_password <varname> [prompt_message]
# - 비밀번호 입력 시 터미널 에코를 끄고(-s) 안전하게 입력받습니다.
# - 입력된 비밀번호에 '비영문'(한글, 일어, 중문, 전각문자 등 ASCII 32~126 이외)이 포함되어 있으면 즉시 경고하고 재입력을 요구합니다.
# 사용법:
#   prompt_password my_pass "🔐 비밀번호 입력 (보안 마스킹): "
prompt_password() {
    local _pw_var="$1"
    local _msg="${2:-🔐 비밀번호 입력 (보안 마스킹): 🔒}"
    local _input=""
    normalize_tty

    while true; do
        printf "${_C_YELLOW}${_C_BOLD}%s${_C_RESET} " "$_msg"
        # Ctrl+C 로 나가기는 부르는 스크립트의 INT trap 이 맡는다(trap 이 없으면 bash 기본 동작으로 종료).
        # bash 5.2 는 INT trap 이 걸려 있으면 trap 만 실행하고 read 는 계속 기다리므로, INT trap 은 반드시 종료(exit)해야 한다.
        IFS= read -rsp "" _input </dev/tty || true
        echo ""
        strip_term_escapes _input   # 입력 중 누른 Esc(영문 전환 키)가 섞인 것 제거

        if [ -z "$_input" ]; then
            print_warn "비밀번호가 입력되지 않았습니다. 다시 입력해 주세요."
            continue
        fi

        # 비영문/비ASCII 문자(한글, 일어, 중문, 전각문자 등: ASCII 32~126 범위를 벗어나는 모든 문자) 검사
        # ⚠️ 외부 프로세스(grep, python3 sys.argv 등)를 호출하면 커맨드라인 인자로 비밀번호가 노출되므로,
        # bash 서브셸(( ... )) 내부에서 C 로케일 glob 패턴 매칭으로 완전히 안전하게 인메모리 검사합니다.
        # C 로케일에서 [:print:] 는 0x20~0x7E 이므로, 그 밖의 바이트가 하나라도 있으면 참
        local _has_non_ascii=false
        if ( LC_ALL=C; [[ "$_input" == *[![:print:]]* ]] ); then
            _has_non_ascii=true
        fi

        if [ "$_has_non_ascii" = true ]; then
            echo ""
            print_error "입력된 비밀번호에 '비영문(한글/다국어/전각)' 문자가 포함되어 있습니다!"
            print_warn "키보드를 영문 입력 상태로 전환한 뒤 다시 입력해 주세요."
            echo ""
            continue
        fi

        eval "$_pw_var=\$_input"
        break
    done
}

# ── sudo 인증을 스피너보다 먼저 받기 ─────────────────────────────────────────
# sudo 명령을 백그라운드로 돌리고 스피너를 띄우면, 비밀번호 질문("[sudo: authenticate] 비밀번호:")이 스피너에
# 가려지거나 엉켜서 설치가 멈춘 것처럼 보입니다. 설치 초반에는 임시 passwordless sudo 가 있어 묻지 않지만,
# 그 권한이 회수된 뒤(Sublime Merge·Orca·VS Code 단계 등)에는 비밀번호를 묻습니다.
# 그래서 백그라운드 sudo 앞에서 이 함수로 인증을 먼저 받아 둡니다(이미 인증됐거나 root 면 아무것도 묻지 않음).
# 비밀번호를 물을 때는 어느 계정의 비밀번호인지 먼저 알립니다 — sudo 기본 문구("[sudo: authenticate] Password:")만으로는
# 바로 앞 단계에서 다룬 Bitwarden·GitHub·Windows 비밀번호와 헷갈리기 쉽습니다. sudo 비밀번호가 필요한 곳은 모두 이 함수를 거칩니다.
# 사용법: dt2_sudo_auth [이유]   (이유를 주면 "<이유> sudo 권한이 필요합니다" 로 함께 표시)
# 반환: 0 = sudo 를 쓸 수 있음 / 1 = sudo 없음·인증 실패
dt2_sudo_auth() {
    [ "$(id -u)" -eq 0 ] && return 0
    command -v sudo >/dev/null 2>&1 || return 1
    sudo -n true 2>/dev/null && return 0   # 이미 인증됨 또는 passwordless
    normalize_tty
    local _user _reason="${1:+$1 }"
    _user="$(id -un 2>/dev/null || echo "${USER:-}")"
    if grep -qi microsoft /proc/version 2>/dev/null; then
        print_info "${_reason}sudo 권한이 필요합니다. WSL 계정 '${_user}' 의 비밀번호를 입력하세요."
    else
        print_info "${_reason}sudo 권한이 필요합니다. 리눅스 계정 '${_user}' 의 로그인 비밀번호를 입력하세요."
    fi
    # 비밀번호 줄에도 계정 이름을 넣습니다. sudo-rs(Ubuntu 25.10~ 기본)는 -p 문구를 "[sudo: <문구>] 비밀번호:" 로 감싸므로
    # 계정 이름만 넘기고, 기존 sudo 는 문구를 그대로 쓰므로 전체 문구를 넘깁니다(이름의 % 는 확장 문자라 %% 로).
    if sudo --version 2>/dev/null | grep -q 'sudo-rs'; then
        sudo -v -p "${_user} 계정"
    else
        sudo -v -p "[sudo] ${_user//%/%%} 계정 비밀번호: "
    fi
}

